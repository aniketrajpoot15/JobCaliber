# ============================================
# JobCaliber Server — Environment Configuration
# ============================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# WARNING: Never commit .env to Git!
# This .env.example file is safe to commit because
# it contains only placeholder values, not real secrets.
# ============================================

# --- Server ---
NODE_ENV=development
PORT=5000

# --- Database (MongoDB) ---
# Local MongoDB:   mongodb://localhost:27017/jobcaliber
# MongoDB Atlas:   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/jobcaliber
MONGO_URI=mongodb://localhost:27017/jobcaliber

# --- Authentication & Security ---
# IMPORTANT: In production, generate these with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_here_replace_with_64_byte_hex
JWT_EXPIRE=7d
COOKIE_SECRET=your_cookie_secret_here_replace_with_64_byte_hex

# --- Client Application URL (CORS Whitelist) ---
CLIENT_URL=http://localhost:5173
